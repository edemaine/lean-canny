  intro H
  have HI:=H.image (fun y : Fin 1→ℝ=>y 0) (continuous_apply 0).continuousOn
  have HM : (-1 : ℝ)∈(fun y : Fin 1→ℝ=>y 0) '' punctured.realization := by
