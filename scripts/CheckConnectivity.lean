example {P : BoundedFullWriter.Readers} {p : List Bool → Formula} (h : P.PolyTime)
    (hp : (fun c => (p c).encode) ∈ FP) (ht : ∀ c, (TermView.term (P.source c)).arity ≤ P.dim c)
    (hs : ∀ c, (p c).arity ≤ 2 * (P.dim c + 4)) :
