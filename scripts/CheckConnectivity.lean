def linear (q : List Bool) : List Bool :=
  if Nat.fromBitsLE (pairFst (pairSnd q))=0 then [false,true] else
  if Nat.fromBitsLE (pairFst (pairSnd q))=1 then [true] else []
def zeroConstant (q : List Bool) : List Bool :=
  if Nat.fromBitsLE (pairFst (pairSnd q))=1 then [true] else []
