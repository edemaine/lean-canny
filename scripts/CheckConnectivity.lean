    (((BinaryFn.fromBits IntegralPowerProductBits.rowWord_FP).eq (BinaryFn.fromBits IntegralPowerProductBits.colWord_FP)).ite_mem_FP
      (constFn_mem_FP (BinaryNatCode.encode 5)) (constFn_mem_FP []))

