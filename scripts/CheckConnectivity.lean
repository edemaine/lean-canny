  unfold residueBits
  decide
example (answer : List Bool → List Bool) (budget : List Bool → ℕ) (q c : List Bool) :
    ¬ (IntegralIntegerCompanionBits.leaf (F 2 3)).controller.Requests answer budget q c := by
  rw [SingleCall.Program.requests_iff]
