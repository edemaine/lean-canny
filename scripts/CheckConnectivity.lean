variable (F : Parameters) (a : Access F)
private def next : List Bool → List Bool := child F id (birth F) .originalCoefficient (fun _ => [])
private def P : SingleCall.Program where
  request q := decide (0 < phase q)
  query := next F
  immediate _ := []
