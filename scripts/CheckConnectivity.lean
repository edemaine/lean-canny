    FormulaRationalSlice.solutionSet P (fun _ => (Formula.eqZero (.const 0)).encode) N D u = {x | x ≠ 0} := by
  ext x
  simp only [FormulaRationalSlice.solutionSet, Set.mem_ofPred_eq, FormulaView.formula_encode, Formula.Holds,
