  rw [valid_value 1 4 (by decide), row_value, col_value 1 4 (by decide), radix_value]
  decide

private theorem request_bad : ¬ request F (q 1 5) := by
  unfold request
  rw [valid_value 1 5 (by decide), row_value, col_value 1 5 (by decide), radix_value]
  decide

