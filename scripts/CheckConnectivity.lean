  constructor
  · intro h
    have h0 := h 0 (by unfold FormulaAtomPolynomials.budget; omega)
    simpa only [hD 0, Polynomial.map_X, Polynomial.eval_X] using h0
  · intro hx i _
    simpa only [hD i, Polynomial.map_X, Polynomial.eval_X] using hx

