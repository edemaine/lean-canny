    (MvPolynomial.C ((2, 3) : ℤ × ℤ) : MvPolynomial (Fin 1) (ℤ × ℤ))).coeff 0 = 5 := by
  rw [PurePowerReductionBits.coefficientPolynomial_coeff, MvPolynomial.coeff_C, ite_eq_left rfl]
