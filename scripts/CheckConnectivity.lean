namespace OriginalSquarefreeArcRegression
open LeanCanny LeanCanny.Algebra LeanCanny.Geometry LeanCanny.Connectivity MvPolynomial
open scoped Classical BigOperators
set_option backward.isDefEq.respectTransparency false

private noncomputable abbrev repeated : Polynomial SymbolicScaledSquarefree.Coefficient := Polynomial.X ^ 2
private noncomputable abbrev f := SymbolicUnivariateRootFamily.value repeated
private noncomputable abbrev Q : Polynomial (Polynomial ℝ) := Polynomial.C Polynomial.X * Polynomial.X
private noncomputable abbrev g := PolynomialRootFamily.value (UnivariateRootFamily.rows Q)

private theorem f_eq (t : ℝ) (x : Fin 1 → ℝ) (i : Fin 1) : f (t, x) i = x 0 ^ 2 := by
  simpa only [repeated, Polynomial.eval₂_pow, Polynomial.eval₂_X] using
    SymbolicUnivariateRootFamily.value_eq repeated t x i
private theorem g_eq (t : ℝ) (x : Fin 1 → ℝ) (i : Fin 1) : g (t, x) i = t * x 0 := by
  change (Q.toMvPolynomial (0 : Fin 1)).eval₂ (Polynomial.evalRingHom t) x = _
  rw [UnivariateRootFamily.eval]
  simp [Q]
private theorem f_zero (t : ℝ) (x : Fin 1 → ℝ) : f (t, x) = 0 ↔ x 0 = 0 := by
  constructor
  · intro h
    have H := congrFun h 0
    rw [f_eq, Pi.zero_apply] at H
    exact (pow_eq_zero_iff (by decide : 2 ≠ 0)).mp H
  · intro h
    funext i
    simp only [f_eq, h, zero_pow (by decide : 2 ≠ 0), Pi.zero_apply]
private theorem g_zero (t : ℝ) (x : Fin 1 → ℝ) : g (t, x) = 0 ↔ t * x 0 = 0 := by
  constructor
  · intro h
    simpa only [g_eq, Pi.zero_apply] using congrFun h 0
  · intro h
    funext i
    exact (g_eq t x i).trans h

-- Every original spatial root is repeated.
example (t : ℝ) : (MvPolynomial.pderiv 0 (UnivariateRootFamily.rows
    (SymbolicUnivariateRootFamily.realPolynomial repeated) 0)).eval₂
    (Polynomial.evalRingHom t) (fun _ => 0) = 0 := by
  change (MvPolynomial.pderiv 0 ((SymbolicUnivariateRootFamily.realPolynomial repeated).toMvPolynomial (0 : Fin 1))).eval₂
    (Polynomial.evalRingHom t) (fun _ => 0) = 0
  rw [UnivariateRootFamily.pderiv, ite_eq_left rfl, UnivariateRootFamily.eval]
  norm_num [SymbolicUnivariateRootFamily.realPolynomial, repeated]

-- The auxiliary endpoint has false roots, so global auxiliary properness is unavailable.
example : g (0, fun _ => 1) = 0 ∧ f (0, fun _ => 1) ≠ 0 := by
  constructor
  · apply (g_zero 0 _).mpr
    norm_num
  · intro h
    have H := (f_zero 0 (fun _ => 1)).mp h
    norm_num at H

private theorem original_proper : IsProperMap (RootProjection.projection f) := by
  apply RootProjection.isProperMap_of_compact_bound f
    (SymbolicUnivariateRootFamily.contDiff_value repeated 1).continuous (K := {0}) isCompact_singleton
  intro z
  change z.val.2 = 0
  have H := (f_zero z.val.1 z.val.2).mp z.property
  funext i
  have hi : i = 0 := Subsingleton.elim _ _
  simpa only [hi, Pi.zero_apply] using H

-- Nevertheless complete auxiliary branches extend only to actual original roots.
example : ∃ curve : RootBranches.Index g 0 1 ⟨(1 : ℝ) / 2, by norm_num⟩ → ℝ → Fin 1 → ℝ,
    ∀ j, curve j 0 0 = 0 := by
  have heq (t : ℝ) (ht : t ∈ Set.Ioo (0 : ℝ) 1) (x : Fin 1 → ℝ) : f (t, x) = 0 ↔ g (t, x) = 0 := by
    rw [f_zero, g_zero, mul_eq_zero, or_iff_right (ne_of_gt ht.1)]
  have hregular (z : RootProjection.Space g) (hz : RootProjection.projection g z ∈ Set.Ioo (0 : ℝ) 1) :
      (fderiv ℝ g z.val ∘L ContinuousLinearMap.inr ℝ ℝ (Fin 1 → ℝ)).IsInvertible := by
    apply UnivariateRootFamily.regular Q z.val.1 z.val.2 ?_ z.property
    have ht : z.val.1 ≠ 0 := ne_of_gt hz.1
    have hq : Q.map (Polynomial.evalRingHom z.val.1) = Polynomial.C z.val.1 * Polynomial.X := by simp [Q]
    rw [hq]
    exact Polynomial.Separable.unit_mul (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr ht)) Polynomial.separable_X
  obtain ⟨_, curve, _, _, hroot, _, _⟩ := OriginalRootArcs.exists_anchored_arcs f g 0 1
    ⟨(1 : ℝ) / 2, by norm_num⟩ heq (SymbolicUnivariateRootFamily.contDiff_value repeated 1).continuous
    original_proper (fun _ _ => (PolynomialRootFamily.contDiff_value _ 1).contDiffAt) hregular
    (fun _ => SymbolicSquarefreeArcs.limitPolynomial repeated)
    (fun _ => SymbolicSquarefreeArcs.limitPolynomial_ne_zero repeated (by simp [repeated]))
    (fun z _ i => by
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      rw [SymbolicSquarefreeArcs.limit_relation]
      exact (SymbolicUnivariateRootFamily.value_zero_iff repeated z.val.1 z.val.2).mp z.property)
  refine ⟨curve, fun j => (f_zero 0 _).mp (hroot j 0 ?_)⟩
  norm_num


-- The auxiliary projection really is nonproper: its zero fiber covers ℝ.
example : ¬IsProperMap (RootProjection.projection g) := by
  intro hp
  let read : RootProjection.Space g → ℝ := fun z => z.val.2 0
  have hc : Continuous read := (continuous_apply 0).comp
    (continuous_snd.comp continuous_subtype_val)
  have hi := (hp.isCompact_preimage (isCompact_singleton (x := (0 : ℝ)))).image hc
  have he : read '' (RootProjection.projection g ⁻¹' {(0 : ℝ)}) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro a
    let z : RootProjection.Space g := ⟨(0, fun _ => a), (g_zero 0 _).mpr (by ring)⟩
    exact ⟨z, rfl, rfl⟩
  rw [he] at hi
  exact noncompact_univ ℝ hi

example : SymbolicScaledSquarefree.exceptional (0 : Polynomial SymbolicScaledSquarefree.Coefficient) = 0 := by
  simp [SymbolicScaledSquarefree.exceptional]
example : SymbolicScaledSquarefree.exceptional (1 : Polynomial SymbolicScaledSquarefree.Coefficient) = 1 := by
  simp [SymbolicScaledSquarefree.exceptional]

-- The general diagonal construction includes the empty coordinate family.
example (t : ℝ) (x : Fin 0 → ℝ) :
    (fderiv ℝ (SquarefreeRootFamily.value
      (fun i : Fin 0 => SymbolicScaledSquarefree.polynomial (Fin.elim0 i))) (t, x) ∘L
      ContinuousLinearMap.inr ℝ ℝ (Fin 0 → ℝ)).IsInvertible := by
  apply SquarefreeRootFamily.regular_away (fun i : Fin 0 => Fin.elim0 i) t x
  · intro i
    exact Fin.elim0 i
  · funext i
    exact Fin.elim0 i
end OriginalSquarefreeArcRegression


open LeanCanny LeanCanny.Algebra LeanCanny.Geometry MvPolynomial Set
open scoped Classical BigOperators
set_option backward.isDefEq.respectTransparency false
namespace SingularCompactComponentRegression
noncomputable section
private def p : MvPolynomial (Fin 1) ℤ := X 0 ^ 2
private def active : Finset (Fin 1) := ∅
private def a : Fin 2 → Fin 1 → ℤ := fun _ _ => 1
private def b : Fin 1 → MvPolynomial (Fin 0) ℤ := fun _ => 0
private def x : Fin 0 → ℝ := fun _ => 0
private def S : Set (Fin 1 → ℝ) :=
  {y | p.eval₂ (Int.castRingHom ℝ) y = 0 ∧ ∀ j ∈ active,
    ∑ i, (a j.succ i : ℝ) * y i = (b j).eval₂ (Int.castRingHom ℝ) x}
private theorem S_eq : S = {0} := by
  ext y
  simp only [S, p, active, eval₂_pow, eval₂_X, Set.mem_ofPred_eq, Finset.notMem_empty,
    false_implies, implies_true, and_true, Set.mem_singleton_iff]
  constructor
  · intro H
    have hy : y 0 = 0 := (pow_eq_zero_iff (by decide : (2 : ℕ) ≠ 0)).mp H
    funext i
    have hi : i = 0 := Subsingleton.elim _ _
    simpa only [hi, Pi.zero_apply] using hy
  · rintro rfl
    norm_num

-- A double root is a singular singleton component. Component sampling must
-- retain it even though no regular point exists in this slice.
example : ∃ (y : Fin 1 → ℝ) (mu : Fin 2 → ℝ), y ∈ connectedComponentIn S 0 ∧
    ∀ j, (FlatAffineCriticalStage.row p active a b j).eval₂ (Int.castRingHom ℝ)
      (Sum.elim x (Sum.elim y mu)) = 0 := by
  apply FlatAffineSingularComponentSampling.exists_component_stage_root (Int.castRingHom ℝ) p active a b x
  · change IsCompact S
    rw [S_eq]
    exact isCompact_singleton
  · intro c hc j
    exact False.elim (Finset.notMem_empty j.val j.property)
  · rintro ⟨c, hc⟩
    have H := hc 0
    have HS : (∑ j : active, c j * (Int.castRingHom ℝ) (a j.val.succ (0 : Fin 1))) = 0 :=
      Finset.sum_eq_zero (fun j _ => False.elim (Finset.notMem_empty j.val j.property))
    rw [HS] at H
    norm_num [a] at H
  · norm_num [p]
  · intro j hj
    exact False.elim (Finset.notMem_empty j hj)
end
end SingularCompactComponentRegression

namespace IntegralHeightRegression
open Polynomial LeanCanny.Algebra
open scoped Classical

-- An annihilator may have a zero branch. Recovery only requires the
-- selected scalar value to be nonzero, not invertibility on every branch.
example (t : ℝ) :
    (((2 : ℝ) * t) * (IntegralParameterInverse.inverse (Polynomial.X ^ 2 - Polynomial.C 2 * Polynomial.X : ℤ[X])).eval₂
      (Int.castRingHom ℝ) 2) /
      ((IntegralParameterInverse.denominator (Polynomial.X ^ 2 - Polynomial.C 2 * Polynomial.X : ℤ[X]) : ℤ) : ℝ) = t := by
  have hp : (Polynomial.X ^ 2 - Polynomial.C 2 * Polynomial.X : ℤ[X]) ≠ 0 := by
    intro h
    have H := congrArg (fun p : ℤ[X] => p.coeff 1) h
    norm_num at H
  exact IntegralParameterInverse.recover _ (Int.castRingHom ℝ) 2 (by norm_num) (by norm_num)
    (Int.cast_ne_zero.mpr (IntegralParameterInverse.denominator_ne_zero _ hp)) t

section DegreeDrop
variable {A ι : Type*} [CommRing A] [Nontrivial A] [Fintype ι] [DecidableEq ι]

private noncomputable def equation (a c : A) : A[X] := Polynomial.C a * Polynomial.X ^ 3 + Polynomial.C c * Polynomial.X ^ 2 - Polynomial.C 4

-- The formal cubic coefficient vanishes after specialization. The extension
-- still has relative rank two, and recovers the genuine specialized root.
example (b : Module.Basis ι ℤ A) (a c : A) (φ : A →ₐ[ℤ] ℝ) (ha : φ a = 0) (hc : φ c = 2)
    (t : ℝ) (ht : 2 * t ^ 2 - 4 = 0) :
    ∃ (hd : ((equation a c).map φ.toRingHom).natDegree = 2)
      (hr : (equation a c).eval₂ φ.toRingHom t = 0),
      IntegralParameterExtension.evaluate (equation a c) 2 φ t hd (by decide) hr
        (IntegralParameterExtension.numerator b (equation a c) 2) /
        ((IntegralParameterExtension.denominator b (equation a c) 2 : ℤ) : ℝ) = t := by
  have HM : (equation a c).map φ.toRingHom = (Polynomial.C 2 * Polynomial.X ^ 2 - Polynomial.C 4 : ℝ[X]) := by
    simp [equation, ha, hc]
    exact map_natCast φ 4
  have hd : ((equation a c).map φ.toRingHom).natDegree = 2 := by
    rw [HM]
    compute_degree!
  have hr : (equation a c).eval₂ φ.toRingHom t = 0 := by
    have H := congrArg (fun p : ℝ[X] => p.eval t) HM
    simpa only [Polynomial.eval_map, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, ht] using H
  exact ⟨hd, hr, IntegralParameterExtension.recover b (equation a c) 2 φ t hd (by decide) hr⟩

end DegreeDrop

-- The new root acts by this companion matrix, with columns in power order.
example : Algebra.leftMulMatrix
    (IntegralParameterExtension.relativeBasis (Polynomial.X ^ 2 - Polynomial.C 2 : ℤ[X]) 2)
    (AdjoinRoot.root _) = !![0, 2; 1, 0] := by
  ext i j
  rw [IntegralParameterExtension.root_matrix]
  fin_cases i <;> fin_cases j <;> norm_num

end IntegralHeightRegression

namespace MonicParameterInfinityRegression
open LeanCanny.Algebra
open scoped Classical

#guard MonicParameterPowerSchedule.weight 2 1 0 == 1
#guard MonicParameterPowerSchedule.weight 2 1 1 == 5
#guard MonicParameterPowerSchedule.weight 2 1 2 == 25
#guard MonicParameterPowerSchedule.weight 2 0 5 == 1

-- The selected leading coefficient is itself an old coordinate and can
-- vanish. The new infinity equation still has leading term new^10.
private noncomputable def equation : Polynomial (MvPolynomial (Fin 1) ℤ) :=
  Polynomial.monomial 2 (MvPolynomial.X 0) + Polynomial.C (MvPolynomial.C (-2))

example (y : Option (Fin 1 ⊕ Unit) → ℂ) (hy : y none = 0) :
    (WeightedHomogenization.homogenize (fun _ => 1) 10
      (MonicParameterRows.row equation 2 (fun _ => 1) 5)).eval₂ (Int.castRingHom ℂ) y =
        y (some (Sum.inr ())) ^ 10 := by
  apply MonicParameterRows.eval_infinity (Int.castRingHom ℂ) equation 2 1 (fun _ => 1) 5
    (by decide) (by decide) ?_ y hy
  intro k
  apply (CoordinatePowerSubstitution.degree_le (fun _ : Fin 1 => 1) (equation.coeff k) 1 (by simp)).trans
  simp only [Nat.one_mul]
  simp only [equation, Polynomial.coeff_add, Polynomial.coeff_monomial, Polynomial.coeff_C]
  split_ifs <;> first | omega | norm_num
  rw [← map_ofNat (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 1) ℤ) 2, MvPolynomial.totalDegree_C]
  omega

end MonicParameterInfinityRegression

namespace GradedReductionRegression
open LeanCanny.Algebra Matrix
open scoped Classical BigOperators

private def T : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 3; 0, 1, -1; 0, 0, 0]
private def normal (i : Fin 3) : Prop := i.val < 2
private def degree (i : Fin 3) : ℕ := if i.val = 2 then 1 else 0
private def v : Fin 3 → ℝ := ![1, 1, 2]
private def shift (_ : {i : Fin 3 // normal i}) : Fin 3 := 2

private theorem shift_value (j : Fin 3) (hj : normal j) : v 2 = 2 * v j := by
  change j.val < 2 at hj
  have H : j.val = 0 ∨ j.val = 1 := by omega
  rcases H with h0 | h1
  · have h : j = 0 := Fin.ext h0
    subst j
    norm_num [v]
  · have h : j = 1 := Fin.ext h1
    subst j
    norm_num [v]

-- Two normal states have the same evaluation. Independence is unnecessary:
-- the reduced multiplication relations still annihilate the selected value.
example : (GradedReductionAnnihilator.matrix T normal 1 shift).charpoly.eval₂ (Int.castRingHom ℝ) 2 = 0 := by
  apply GradedReductionAnnihilator.charpoly_root T normal degree ?_ ?_ 1 ?_ shift
    (Int.castRingHom ℝ) v ?_ 2 ?_ ?_
  · intro j hj i
    fin_cases j <;> fin_cases i <;> norm_num [T, normal] at *
  · intro i j hj hT
    fin_cases i <;> fin_cases j <;> norm_num [T, normal, degree] at *
  · intro i
    fin_cases i <;> norm_num [degree]
  · ext j
    fin_cases j <;> norm_num [T, v, Matrix.vecMul, dotProduct, Fin.sum_univ_succ]
  · intro j
    exact shift_value j.val j.property
  · exact ⟨⟨0, by change (0 : ℕ) < 2; omega⟩, by norm_num [v]⟩

private def S : Matrix (Fin 3) (Fin 3) ℤ := (2 : ℤ) • T
private noncomputable def clearedMatrix : Matrix (Fin 3) (Fin 3) ℤ :=
  GradedReductionAnnihilator.paddedMatrix S normal 1 (fun _ => 2)

-- Clearing denominator two scales a two-step reduction by four. Scaling
-- the characteristic variable back by four recovers the original value two.
example : (ScaledGradedReductionAnnihilator.polynomial clearedMatrix 2 2).eval₂ (Int.castRingHom ℝ) 2 = 0 := by
  apply ScaledGradedReductionAnnihilator.root
  apply ScaledGradedReductionAnnihilator.padded_charpoly_root S normal degree (2 : ℤ)
    ?_ ?_ 1 ?_ (fun _ => 2) (Int.castRingHom ℝ) v ?_ 2 ?_ ?_
  · intro j hj i
    fin_cases j <;> fin_cases i <;> norm_num [S, T, normal, Matrix.smul_apply] at *
  · intro i j hj hS
    fin_cases i <;> fin_cases j <;> norm_num [S, T, normal, degree, Matrix.smul_apply] at *
  · intro i
    fin_cases i <;> norm_num [degree]
  · ext j
    fin_cases j <;> norm_num [S, T, v, Matrix.smul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_succ]
  · exact shift_value
  · exact ⟨0, by change (0 : ℕ) < 2; omega, by norm_num [v]⟩

example : ((ScaledGradedReductionAnnihilator.polynomial clearedMatrix 2 2).map (Int.castRingHom ℝ)).natDegree = 3 := by
  simpa only [Fintype.card_fin] using ScaledGradedReductionAnnihilator.specialized_degree
    clearedMatrix 2 2 (Int.castRingHom ℝ) (by norm_num)

end GradedReductionRegression

