  bound := BinaryFn.const 0
  shift := BinaryFn.const 1
  normal := by
    apply ((BinaryFn.fromBits MatrixMoment.EntryBits.colIndex_mem_FP).mod (BinaryFn.const 2)).eq (BinaryFn.const 0) |>.of_iff
