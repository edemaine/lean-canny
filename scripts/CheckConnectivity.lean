    have HH : y 0=(v : ℝ) :=
      (congrArg y (show (0 : Fin 1)=⟨0,zero_lt_one⟩ from Fin.ext rfl)).trans HH'
    funext i
    have HI : i=(0 : Fin 1) := Subsingleton.elim _ _
    simpa only [HI] using HH
