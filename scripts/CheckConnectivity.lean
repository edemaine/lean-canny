    (MvPolynomial.monomial exponents 5)).coeff 0 = 0 := by
  rw [cleared_monomial, MvPolynomial.coeff_monomial]
  have H : Finsupp.single (0 : Fin 1) 1 ≠ (0 : Fin 1 →₀ ℕ) := by
    intro h
    have H := congrArg (fun e : Fin 1 →₀ ℕ => e (0 : Fin 1)) h
    norm_num at H
  rw [ite_eq_right H]

