    (cone : FlatAffinePowerPositive.ConeCertificate (FlatAffineCompleteRootStages.next F)) (u v : List Bool) :
    FlatAffineRetainedPointChildMatch.record u v (F.depth u) 0 ∉ FlatAffineRetainedPointChildMatch.hits F cone := by
