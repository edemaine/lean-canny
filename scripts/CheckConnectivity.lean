    rw [HT]
    change SignType.sign (Formula.extend (L r) 0)=SignType.neg
    simp only [Formula.extend,dite_eq_left hn]
    exact sign_neg hr
  apply closure_mono HS
  exact image_closure_subset_closure_image HL ⟨0,by simp [closure_Iio],rfl⟩
