        2^(factor (F.ambient q) (H.rank q) (H.sourceWidth q) (H.spatialDegree q)
          (F.cap q) (H.nodes q)*H.bankHeight q) := by
  rw [← height_eq_factor]
  exact coefficient_height F I H q c k u v

