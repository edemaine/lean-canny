example (y : Fin 3 → ℝ) : (polynomial F []).eval (Formula.extend y)=0 ↔
    y 2=0 ∧ y 0^2+y 1^2=1 := by
  rw [polynomial_zero_iff]
  have HR : (root F []).eval (Formula.extend y) = y 2 := by norm_num [root,F,Term.eval,Formula.extend]
