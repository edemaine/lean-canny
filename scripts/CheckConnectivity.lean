private def L : PurePowerReductionShiftBits.Layout where
  arity _ := 1
  width _ := 2
  degree _ _ := 2
  bound _ := 3
  grid_le _ := by norm_num [PurePowerReductionMatrix.gridBound, Fin.sum_univ_succ]
  bound_lt _ := by decide
