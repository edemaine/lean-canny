    have H := p.property
    change (polynomial 1 equation).eval p.val=0 at H
    norm_num [polynomial,equation,Term.eval,FixedLeadingTiltedGradient.coordinateVars] at H
    rw [Subsingleton.elim i 0]
    linarith
  exact ⟨cs,hlen,hcs,hLimit,HP ▸ hread⟩

