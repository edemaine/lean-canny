private theorem width_bound (c : List Bool) : PurePowerReductionBounds.dimension (F.ambient c + 1) (F.degreeBound c) ≤ 2 ^ 2 := by
  change PurePowerReductionBounds.dimension 1 2 ≤ 2 ^ 2
  decide

