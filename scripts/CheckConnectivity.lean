namespace ClearedCoordinateRegression

example (x : ℝ) (hx : x ^ 2 = 3 / 4) :
    (ClearedCoordinateCritical.annihilator 2 (2 : ℤ) (fun _ => 1) 1 (by decide : 1 + (0 + 1) ≤ 1 + 1)
