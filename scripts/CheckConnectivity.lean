    (HG : x.bank.Bounds G) (HC : ∀ e, (P.low.coeff e).natAbs ≤ 2 ^ C) :
    (criticalStep x hm r).bank.Bounds
      (max G (bankStepHeight (count m B) (2 ^ B) (criticalHeight x hm r G C HG HC))) :=
  criticalStep_bank_bounds x hm r G C HG HC
