private noncomputable def q : Polynomial ℤ := Polynomial.C 3*Polynomial.X+Polynomial.C (-9)
private theorem hp : p≠0 := by
  intro H
  have HC := congrArg (fun f : Polynomial ℤ => f.coeff 0) H
  norm_num [p] at HC
private theorem hq : q≠0 := by
  intro H
  have HC := congrArg (fun f : Polynomial ℤ => f.coeff 0) H
  norm_num [q] at HC
