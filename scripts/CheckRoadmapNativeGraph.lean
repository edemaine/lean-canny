  intro H
  have HI:=H.2.1
  omega
example : ¬IntegralMixedChronologicalMidpointCode.Good 3 3 frozen 1 2 2 1 :=by
  intro H
  have HI:=H.2.2.2.2.2.1
  change 2≤1 at HI
  omega
