  obtain ⟨_,HRa,HEa⟩:=(markerAt_iff hn ht ha hR0 c a hA hc).mp hmA
  obtain ⟨_,HRb,HEb⟩:=(markerAt_iff hn ht ha hR0 c b hB hd).mp hmB
  rw [HEa,HEb]
  exact preludeAt_joined_same_candidate hn ht ha hR0 c a b hA hB hc hd HRa HRb

