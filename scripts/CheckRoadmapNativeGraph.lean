example (u label w :List Bool)
    (hv :IntegralMixedRoadmapAtomic.Valid hn ht ha hR0
      (IntegralMixedRoadmapAtomic.packet (pair u label)
        (IntegralMixedRoadmapSeedResampling.payload (n u+3)) w))
