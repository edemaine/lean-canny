example {R T A B :Type*} [CommRing R] [CommRing T] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra T B] {m N :ℕ} (φ :R→+*T) (ψ :A→+*B)
    (b :CoefficientCoordinateBasis R A m N) (c :CoefficientCoordinateBasis T B m N)
