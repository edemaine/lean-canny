example (u label :List Bool)
    (hg :LeanCanny.Connectivity.AuxiliaryCandidateComponentCover.Good hn ht ha u label)
    (hR :IntegralMixedAuxiliaryCandidateRadius.radius hn ht ha u≤R0 u) :
