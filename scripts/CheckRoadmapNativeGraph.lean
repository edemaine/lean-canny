      ((actualFamily hn ht ha (fun _ => 0)).kind key) k r s).natAbs ≤ 2 ^ rawOffset hn ht ha (pairFst key) := by
  simpa only [Nat.mul_zero, Nat.zero_add] using raw_coefficient_bound hn ht ha (fun _ => 0) key k r s

