module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.Data.List.Nodup

/-! # Regular sequences of distinct coordinate powers

Multiplication by a power of an unused variable is injective modulo any
ideal generated by powers of other variables. Consequently powers of
distinct variables form a weakly regular sequence over every commutative
coefficient ring, and a regular sequence when the powers are positive and
the coefficient ring is nontrivial.
-/

@[expose] public section

namespace LeanCanny.Algebra.CoordinatePowerRegularity
open scoped Classical
variable {σ R : Type*} [CommRing R]

noncomputable def powerIdeal (d : σ → ℕ) (s : Set σ) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun j => MvPolynomial.X j ^ d j) '' s)

theorem mem_powerIdeal_iff (d : σ → ℕ) (s : Set σ) (f : MvPolynomial σ R) :
    f ∈ powerIdeal d s ↔ ∀ m ∈ f.support, ∃ j ∈ s, d j ≤ m j := by
  have hs : ((fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j) '' s) =
      ((fun m => MvPolynomial.monomial m (1 : R)) '' ((fun j => Finsupp.single j (d j)) '' s)) := by
    simp only [Set.image_image, MvPolynomial.X_pow_eq_monomial]
  rw [powerIdeal, hs, MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h m hm
    obtain ⟨_, ⟨j, hj, rfl⟩, he⟩ := h m hm
    exact ⟨j, hj, Finsupp.single_le_iff.mp he⟩
  · intro h m hm
    obtain ⟨j, hj, he⟩ := h m hm
    exact ⟨Finsupp.single j (d j), ⟨j, hj, rfl⟩, Finsupp.single_le_iff.mpr he⟩

theorem mem_of_coordinate_power_mul_mem (d : σ → ℕ) (s : Set σ) (i : σ) (hi : i ∉ s) (N : ℕ)
    (f : MvPolynomial σ R) (hf : MvPolynomial.X i ^ N * f ∈ powerIdeal d s) : f ∈ powerIdeal d s := by
  rw [mem_powerIdeal_iff] at hf ⊢
  intro m hm
  have hc : (MvPolynomial.X i ^ N * f).coeff (Finsupp.single i N + m) = f.coeff m := by
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial_mul, one_mul]
  have hs : Finsupp.single i N + m ∈ (MvPolynomial.X i ^ N * f).support := by
    rw [MvPolynomial.mem_support_iff, hc]
    exact MvPolynomial.mem_support_iff.mp hm
  obtain ⟨j, hj, he⟩ := hf _ hs
  have hji : j ≠ i := by intro h; subst j; exact hi hj
  refine ⟨j, hj, ?_⟩
  simpa only [Finsupp.add_apply, Finsupp.single_eq_of_ne hji, zero_add] using he

theorem isSMulRegular_quotient (d : σ → ℕ) (s : Set σ) (i : σ) (hi : i ∉ s) (N : ℕ) :
    IsSMulRegular (MvPolynomial σ R ⧸ powerIdeal d s) ((MvPolynomial.X i : MvPolynomial σ R) ^ N) := by
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mpr
  intro f hf
  exact mem_of_coordinate_power_mul_mem d s i hi N f hf

theorem ofList_map_eq_powerIdeal (d : σ → ℕ) (l : List σ) :
    Ideal.ofList (l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)) = powerIdeal d {j | j ∈ l} := by
  unfold Ideal.ofList powerIdeal
  congr 1
  ext f
  simp only [Set.mem_ofPred_eq, List.mem_map, Set.mem_image]

theorem smul_top_eq_powerIdeal (d : σ → ℕ) (l : List σ) :
    (Ideal.ofList (l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)) •
      (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R))) = powerIdeal d {j | j ∈ l} := by
  change (Ideal.ofList (l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)) * ⊤ : Ideal _) = _
  rw [Ideal.mul_top, ofList_map_eq_powerIdeal]

theorem isWeaklyRegular_map_powers (d : σ → ℕ) (l : List σ) (hl : l.Nodup) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial σ R) (l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)) := by
  constructor
  intro k hk
  have hk' : k < l.length := by simpa only [List.length_map] using hk
  have hnot : l[k] ∉ l.take k := by
    intro hm
    obtain ⟨j, hj, he⟩ := List.mem_take_iff_getElem.mp hm
    have hji : j = k := hl.getElem_inj_iff.mp he
    omega
  have he := isSMulRegular_quotient (R := R) d {j | j ∈ l.take k} l[k] hnot (d l[k])
  have hI : (Ideal.ofList ((l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)).take k) •
      (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R))) = powerIdeal d {j | j ∈ l.take k} := by
    rw [← List.map_take]
    exact smul_top_eq_powerIdeal d (l.take k)
  rw [hI, List.getElem_map]
  exact he

theorem isRegular_map_powers [Nontrivial R] (d : σ → ℕ) (l : List σ) (hl : l.Nodup) (hd : ∀ j ∈ l, 0 < d j) :
    RingTheory.Sequence.IsRegular (MvPolynomial σ R) (l.map (fun j => (MvPolynomial.X j : MvPolynomial σ R) ^ d j)) := by
  refine { toIsWeaklyRegular := isWeaklyRegular_map_powers d l hl, top_ne_smul := ?_ }
  rw [smul_top_eq_powerIdeal]
  intro he
  have hmem : (1 : MvPolynomial σ R) ∈ powerIdeal d {j | j ∈ l} := he ▸ Submodule.mem_top
  obtain ⟨j, hj, hle⟩ := (mem_powerIdeal_iff d {j | j ∈ l} 1).mp hmem 0 (by simp)
  have hpos := hd j hj
  simp only [Finsupp.zero_apply] at hle
  omega

end LeanCanny.Algebra.CoordinatePowerRegularity
