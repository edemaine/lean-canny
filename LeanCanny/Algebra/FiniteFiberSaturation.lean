module

public import LeanCanny.Algebra.FiniteZeroLocus
public import LeanCanny.Algebra.ProjectiveNullstellensatz
public import LeanCanny.Algebra.MvPolynomialPointHeight
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-! # Radical saturation at a finite deformation fiber

In `n+1` affine variables, a parameter with finite zero fiber belongs to
no minimal prime of an ideal generated by `n` equations.
A prime containing the parameter would be maximal, hence have height `n+1`, contrary
to Krull's height bound of `n`. Powers of the parameter can therefore be
cancelled in the radical ideal, including at singular finite-fiber points.
-/

@[expose] public section

namespace LeanCanny.Algebra.FiniteFiberSaturation
open MvPolynomial
open scoped Classical

theorem cancel_pow_mul_mem_radical {R : Type*} [CommRing R] (I : Ideal R)
    (s f : R) (k : ℕ)
    (hs : ∀ P ∈ I.minimalPrimes, s ∉ P) (hmem : s ^ k * f ∈ I.radical) : f ∈ I.radical := by
  rw [← I.sInf_minimalPrimes, Ideal.mem_sInf]
  intro P hP
  have hp := hP.isPrime
  have hle : I.radical ≤ P := by simpa only [hp.radical] using Ideal.radical_mono hP.le
  exact (hp.mem_or_mem (hle hmem)).resolve_left (fun hpow => hs P hP (hp.mem_of_pow_mem k hpow))

variable {n : ℕ} {K : Type*} [Field K] [IsAlgClosed K]

theorem not_mem_minimalPrimes_of_finite_fiber
    (p : Fin n → MvPolynomial (Fin (n + 1)) K) (s : MvPolynomial (Fin (n + 1)) K)
    (hfinite : (zeroLocus K (ProjectiveNullstellensatz.generated p ⊔ Ideal.span {s})).Finite)
    (P : Ideal (MvPolynomial (Fin (n + 1)) K)) (hP : P ∈ (ProjectiveNullstellensatz.generated p).minimalPrimes) : s ∉ P := by
  intro hs
  let : P.IsPrime := hP.isPrime
  have hle : ProjectiveNullstellensatz.generated p ⊔ Ideal.span {s} ≤ P :=
    sup_le hP.le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hs))
  let : P.IsMaximal := FiniteZeroLocus.isMaximal_of_finite_zeroLocus _ P hfinite hle
  have he := MvPolynomialPointHeight.height_maximal (n + 1) P
  have hbound : P.height ≤ (Finset.univ.image p).card :=
    Ideal.height_le_card_of_mem_minimalPrimes_span_finset (by
      simpa only [ProjectiveNullstellensatz.generated, Finset.coe_image, Finset.coe_univ, Set.image_univ] using hP)
  have hc : (Finset.univ.image p).card ≤ n := (Finset.card_image_le).trans (by simp)
  have hh : P.height ≤ (n : ℕ∞) := hbound.trans (by exact_mod_cast hc)
  rw [he] at hh
  exact Nat.not_succ_le_self n (by exact_mod_cast hh)

theorem cancel_pow_mul_mem_radical_of_finite_fiber
    (p : Fin n → MvPolynomial (Fin (n + 1)) K) (s f : MvPolynomial (Fin (n + 1)) K) (k : ℕ)
    (hfinite : (zeroLocus K (ProjectiveNullstellensatz.generated p ⊔ Ideal.span {s})).Finite)
    (hmem : s ^ k * f ∈ (ProjectiveNullstellensatz.generated p).radical) :
    f ∈ (ProjectiveNullstellensatz.generated p).radical :=
  cancel_pow_mul_mem_radical _ s f k (not_mem_minimalPrimes_of_finite_fiber p s hfinite) hmem

end LeanCanny.Algebra.FiniteFiberSaturation
