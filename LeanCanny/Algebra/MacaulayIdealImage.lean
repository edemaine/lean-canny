module

public import LeanCanny.Algebra.HomogeneousIdealMembership
public import LeanCanny.Algebra.MacaulayMultiplicationMatrix

/-! # The full Macaulay matrix and homogeneous ideal membership

At a fitting exponent width, the row image of the full rectangular matrix
is exactly the degree-level part of the ideal generated by the inputs.
In particular, surjectivity is equivalent to membership of every form of
that degree. The sharp degree bound from absence of projective roots is
separate. `MacaulayQuotientSurjectivity` proves that full matrix
surjectivity makes the polynomial quotient a unit.
-/

@[expose] public section

namespace LeanCanny.Algebra.Macaulay
open scoped Classical Matrix BigOperators
variable {n : ℕ} {R : Type*} [CommRing R]

theorem homogeneous_ext_of_active_coeff (d : Fin n → ℕ) (W : ℕ) (hW : level d < 2 ^ W)
    (f g : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous (level d)) (hg : g.IsHomogeneous (level d))
    (he : ∀ r : activeIndices d W, f.coeff (FixedWidthPolynomial.vector n W r.val) =
      g.coeff (FixedWidthPolynomial.vector n W r.val)) : f = g := by
  ext m
  by_cases hm : m.degree = level d
  · have hb : ∀ j, m j < 2 ^ W := fun j => ((Finsupp.le_degree j m).trans_eq hm).trans_lt hW
    let r := FixedWidthPolynomial.index n W m hb
    have hr : r ∈ activeIndices d W := by rw [mem_activeIndices, FixedWidthPolynomial.vector_index]; exact hm
    have hc := he ⟨r, hr⟩
    simpa only [r, FixedWidthPolynomial.vector_index] using hc
  · rw [hf.coeff_eq_zero hm, hg.coeff_eq_zero hm]

noncomputable def levelPolynomial (d : Fin n → ℕ) (W : ℕ) (v : activeIndices d W → R) : MvPolynomial (Fin n) R :=
  ∑ r, MvPolynomial.monomial (FixedWidthPolynomial.vector n W r.val) (v r)

theorem levelPolynomial_homogeneous (d : Fin n → ℕ) (W : ℕ) (v : activeIndices d W → R) :
    (levelPolynomial d W v).IsHomogeneous (level d) := by
  apply MvPolynomial.IsHomogeneous.sum
  intro r _
  exact MvPolynomial.isHomogeneous_monomial _ ((mem_activeIndices d W r.val).mp r.property)

theorem levelPolynomial_coeff (d : Fin n → ℕ) (W : ℕ) (v : activeIndices d W → R) (r : activeIndices d W) :
    (levelPolynomial d W v).coeff (FixedWidthPolynomial.vector n W r.val) = v r := by
  have he (s : activeIndices d W) : FixedWidthPolynomial.vector n W s.val = FixedWidthPolynomial.vector n W r.val ↔ s = r :=
    (FixedWidthPolynomial.vector_injective n W).eq_iff.trans Subtype.val_injective.eq_iff
  simp only [levelPolynomial, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, he,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]

theorem assemble_homogeneous (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (v : MultiplierIndex d W → R) :
    (assemble p d W v).IsHomogeneous (level d) := by
  apply MvPolynomial.IsHomogeneous.sum
  intro a _
  exact (sourceRow_homogeneous p d W hp a).C_mul (v a)

theorem assemble_mem_generated (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (v : MultiplierIndex d W → R) : assemble p d W v ∈ ProjectiveNullstellensatz.generated p := by
  apply Ideal.sum_mem
  intro a _
  apply Ideal.mul_mem_left
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a.1, rfl⟩)

theorem exists_vecMul_of_homogeneous_mem_generated (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (hW : level d < 2 ^ W)
    (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous (level d)) (hmem : f ∈ ProjectiveNullstellensatz.generated p) :
    ∃ v : MultiplierIndex d W → R, Matrix.vecMul v (fullMatrix p d W) =
      (fun r => f.coeff (FixedWidthPolynomial.vector n W r.val)) := by
  obtain ⟨q, hq, hsum⟩ := HomogeneousIdealMembership.multiplier_support_grade p d hp (level d) f hf hmem
  refine ⟨sourceCoefficients q d W, ?_⟩
  funext r
  rw [vecMul_fullMatrix, assemble_coefficients p q d W hW hq, hsum]

theorem homogeneous_mem_generated_iff_exists_vecMul (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (hW : level d < 2 ^ W)
    (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous (level d)) :
    f ∈ ProjectiveNullstellensatz.generated p ↔
      ∃ v : MultiplierIndex d W → R, Matrix.vecMul v (fullMatrix p d W) =
        (fun r => f.coeff (FixedWidthPolynomial.vector n W r.val)) := by
  constructor
  · exact exists_vecMul_of_homogeneous_mem_generated p d W hp hW f hf
  · rintro ⟨v, hv⟩
    have he : assemble p d W v = f := by
      apply homogeneous_ext_of_active_coeff d W hW _ _ (assemble_homogeneous p d W hp v) hf
      intro r
      rw [← vecMul_fullMatrix, congrFun hv r]
    rw [← he]
    exact assemble_mem_generated p d W v

theorem fullMatrix_surjective_iff_homogeneous_membership (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (hW : level d < 2 ^ W) :
    Function.Surjective (fun v => Matrix.vecMul v (fullMatrix p d W)) ↔
      ∀ f : MvPolynomial (Fin n) R, f.IsHomogeneous (level d) → f ∈ ProjectiveNullstellensatz.generated p := by
  constructor
  · intro h f hf
    exact (homogeneous_mem_generated_iff_exists_vecMul p d W hp hW f hf).mpr (h _)
  · intro h v
    obtain ⟨u, hu⟩ := exists_vecMul_of_homogeneous_mem_generated p d W hp hW (levelPolynomial d W v)
      (levelPolynomial_homogeneous d W v) (h _ (levelPolynomial_homogeneous d W v))
    refine ⟨u, ?_⟩
    simpa only [levelPolynomial_coeff] using hu

theorem no_nonzero_root_of_fullMatrix_surjective [IsDomain R]
    (p : Fin n → MvPolynomial (Fin n) R) (d : Fin n → ℕ) (W : ℕ)
    (hp : ∀ i, (p i).IsHomogeneous (d i)) (hW : level d < 2 ^ W)
    (hsurj : Function.Surjective (fun v => Matrix.vecMul v (fullMatrix p d W)))
    (x : Fin n → R) (hx : ∀ i, MvPolynomial.eval x (p i) = 0) : x = 0 := by
  apply ProjectiveNullstellensatz.coordinate_powers_imply_no_nonzero_root p _ x hx
  intro j
  refine ⟨level d, (fullMatrix_surjective_iff_homogeneous_membership p d W hp hW).mp hsurj _ ?_⟩
  simpa only [one_mul] using (MvPolynomial.isHomogeneous_X (R := R) j).pow (level d)

end LeanCanny.Algebra.Macaulay
