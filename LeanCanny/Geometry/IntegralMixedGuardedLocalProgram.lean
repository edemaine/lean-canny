module
public import LeanCanny.Encoding.IntegralMixedChosenLocalGuardReceipt
public import LeanCanny.Geometry.IntegralMixedOptionalEndpointTrace
/-! # Compositional local programs retain every creating guard receipt

The trace is generated by concrete local receipts. Its final tuple and hom
are indices, so forgetting a physical correlation cannot silently replace
the chosen realization by another full-row root.
-/
@[expose] public section
namespace LeanCanny.Geometry.IntegralMixedOptionalEndpoints
open LeanCanny.Algebra LeanCanny.Encoding IntegralMixedHistory IntegralMixedFullHistoryScript
open IntegralMixedChosenLocalRealization IntegralHistorySampler UniformIntegralPowerSchedule
open scoped Classical
set_option backward.isDefEq.respectTransparency false
variable {n S B m :ℕ} {P :SpatialSource n} {ι :Type} [Fintype ι]

inductive GuardedProgram (x :State P S B m ι) (hn :0<n)
    (hcap :IntegralMixedExceptionalBounds.auxiliaryCap (n+1) P.degree≤2^B)
    (z :ι→ℝ) (φ :x.sampler.scalarPrefix.carrier→ₐ[ℤ]ℝ) (values :Fin m→ℝ) :
    (cs :List (Command P B))→(room :m+cs.length≤S+1)→List (List Bool)→
      (y :Index ι cs→ℝ)→
      ((continueRun x cs room).sampler.scalarPrefix.carrier→ₐ[ℤ]ℝ)→
      (Fin (m+cs.length)→ℝ)→Prop
  | nil (room :m+0≤S+1) :GuardedProgram x hn hcap z φ values [] room [] z φ values
  | cons {cs :List (Command P B)} {room :m+cs.length≤S+1} {codes :List (List Bool)}
      {y :Index ι cs→ℝ} {ψ :(continueRun x cs room).sampler.scalarPrefix.carrier→ₐ[ℤ]ℝ}
      {next :Fin (m+cs.length)→ℝ}
      (tail :GuardedProgram x hn hcap z φ values cs room codes y ψ next)
      (hm :m+cs.length≤S) (a :ℝ) (code :List Bool)
      (r :Receipt (continueRun x cs room) hm hn hcap y ψ next a code) :
      GuardedProgram x hn hcap z φ values (r.command::cs)
        (by simp only [List.length_cons];omega) (code::codes) r.tuple r.hom (Fin.cons a next)

variable {x :State P S B m ι} {hn :0<n}
  {hcap :IntegralMixedExceptionalBounds.auxiliaryCap (n+1) P.degree≤2^B}
  {z :ι→ℝ} {φ :x.sampler.scalarPrefix.carrier→ₐ[ℤ]ℝ} {values :Fin m→ℝ}
  {cs :List (Command P B)} {room :m+cs.length≤S+1} {codes :List (List Bool)}
  {y :Index ι cs→ℝ} {ψ :(continueRun x cs room).sampler.scalarPrefix.carrier→ₐ[ℤ]ℝ}
  {next :Fin (m+cs.length)→ℝ}

theorem GuardedProgram.decode (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next) :
    Decodes x hn hcap cs room codes:=by
  induction H with
  | nil=>rfl
  | cons _ _ _ _ r ih=>exact ⟨ih,r.decode⟩

theorem GuardedProgram.code_count (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next) :
    codes.length=cs.length:=by
  induction H with
  | nil=>rfl
  | cons _ _ _ _ _ ih=>exact congrArg Nat.succ ih

theorem GuardedProgram.roots (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next)
    (hz :∀i,(x.sampler.rows i).eval₂ (Int.castRingHom ℝ) z=0) :
    ∀i,((continueRun x cs room).sampler.rows i).eval₂ (Int.castRingHom ℝ) y=0:=by
  cases H with
  | nil=>exact hz
  | cons _ _ _ _ r=>exact r.roots

theorem GuardedProgram.generators (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next)
    (hφ :∀i,φ (x.sampler.scalarPrefix.basis.generator i)=z (x.sampler.scalar i)^weights S (2^B) m i) :
    ∀i,ψ ((continueRun x cs room).sampler.scalarPrefix.basis.generator i)=
      y ((continueRun x cs room).sampler.scalar i)^weights S (2^B) (m+cs.length) i:=by
  cases H with
  | nil=>exact hφ
  | cons _ _ _ _ r=>exact r.generators

theorem GuardedProgram.quotients (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next)
    (hv :∀i,φ (x.bank.numerator i)/(x.bank.denominator i:ℝ)=values i) :
    ∀i,ψ ((continueRun x cs room).bank.numerator i)/((continueRun x cs room).bank.denominator i:ℝ)=next i:=by
  cases H with
  | nil=>exact hv
  | cons _ _ _ _ r=>exact r.quotients

theorem GuardedProgram.old_raw (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next) :
    ∀i,y (oldColumns cs i)=z i:=by
  induction H with
  | nil=>exact fun _=>rfl
  | cons _ _ _ _ r ih=>exact fun i=>(r.old_raw _).trans (ih i)

theorem GuardedProgram.old_hom (H :GuardedProgram x hn hcap z φ values cs room codes y ψ next) :
    ψ.comp (oldLift x cs room)=φ:=by
  induction H with
  | nil=>rfl
  | cons _ _ _ _ r ih=>
    exact (congrArg (fun χ=>χ.comp (oldLift x _ _)) r.old_hom).trans ih

end LeanCanny.Geometry.IntegralMixedOptionalEndpoints
